<!DOCTYPE html>
<html lang="nl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GoDutchSnelStartWebApp.Portal.styles.css"]" />

    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

    <!-- Verborgen form voor browser-credentialopslag (buiten het zichtbare scherm) -->
    <iframe name="_cred_target" style="position:absolute;left:-9999px;top:-9999px;width:0;height:0;border:0;" aria-hidden="true"></iframe>
    <form id="_cred_form" method="post" action="/login-ok" target="_cred_target" autocomplete="on"
          style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden;">
        <input id="_cred_u" type="text"     name="username" autocomplete="username"         tabindex="-1" />
        <input id="_cred_p" type="password" name="password" autocomplete="current-password" tabindex="-1" />
    </form>

    <script src="_framework/blazor.web.js"></script>
    <script>
        var _scrollToContentRequested = false;

        function requestScrollToContent() {
            _scrollToContentRequested = true;
        }

        function scrollToContentIfRequested() {
            if (_scrollToContentRequested && window.innerWidth <= 900) {
                _scrollToContentRequested = false;
                var el = document.getElementById('app-content');
                if (el) {
                    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        }

        // Print alleen een specifiek onderdeel van de pagina via het Windows-printmenu
        // (window.print() opent het native OS-printdialoogvenster incl. printerselectie).
        // Herbruikbaar: elk onderdeel dat afdrukbaar moet zijn krijgt gewoon een eigen id.
        //
        // Het doel-element wordt (met zijn HTML) gekopieerd naar een losse container die
        // direct onder <body> hangt. Zo'n kopie, buiten de menu/layout-structuur om, print
        // altijd netjes vanaf pagina 1 -- in tegenstelling tot "verberg de rest met
        // visibility:hidden", wat bij een flex/grid-layout lege paginas opleverde omdat
        // verborgen elementen hun ruimte bleven innemen.
        function printElementById(elementId) {
            var target = document.getElementById(elementId);
            if (!target) {
                return;
            }

            var existing = document.getElementById('print-clone-area');
            if (existing) {
                existing.remove();
            }

            var clone = document.createElement('div');
            clone.id = 'print-clone-area';
            clone.innerHTML = target.innerHTML;
            document.body.appendChild(clone);

            document.body.classList.add('print-scoping');

            var cleanedUp = false;
            function cleanup() {
                if (cleanedUp) return;
                cleanedUp = true;
                document.body.classList.remove('print-scoping');
                var el = document.getElementById('print-clone-area');
                if (el) {
                    el.remove();
                }
                window.removeEventListener('afterprint', cleanup);
            }

            window.addEventListener('afterprint', cleanup);
            window.print();
            // Vangnet voor browsers die afterprint niet betrouwbaar afvuren.
            setTimeout(cleanup, 3000);
        }

        async function saveCredentials(username, password) {
            // Methode 1: Credential Management API (Chrome/Edge met HTTPS)
            if (window.PasswordCredential) {
                try {
                    var cred = new PasswordCredential({ id: username, password: password, name: username });
                    await navigator.credentials.store(cred);
                } catch (e) { }
            }

            // Methode 2: Verborgen form POST in iframe (brede browserondersteuning)
            try {
                var u = document.getElementById('_cred_u');
                var p = document.getElementById('_cred_p');
                var f = document.getElementById('_cred_form');
                if (u && p && f) {
                    u.value = username;
                    p.value = password;
                    f.submit();
                }
            } catch (e) { }
        }
    </script>
</body>

</html>