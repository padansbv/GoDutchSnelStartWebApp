@using GoDutchSnelStartWebApp.Portal.Services
@using GoDutchSnelStartWebApp.Portal.Api.Interfaces
@using GoDutchSnelStartWebApp.Portal.Models
@inject AppSession Session
@inject IJSRuntime JSRuntime
@inject IBackendApiClient BackendApiClient
@inject NavigationManager Navigation
@implements IDisposable

<nav class="app-nav">
    <div class="app-brand">
        <div class="app-brand-title">@AppTitle</div>
        <div class="app-brand-subtitle">Koppelingen &amp; exports</div>
    </div>

    @* Overzicht — altijd zichtbaar *@
    <div class="app-nav-section">
        <div class="app-nav-heading-dark">Overzicht</div>

        <NavLink class="app-nav-link" @onclick="ScrollToContent" href="" Match="NavLinkMatch.All">
            <span class="app-nav-link-icon">🏠</span>
            <span>Start</span>
        </NavLink>

        <NavLink class="app-nav-link" @onclick="ScrollToContent" href="notifications" Match="NavLinkMatch.Prefix">
            <span class="app-nav-link-icon">🔔</span>
            <span>Meldingen</span>
            <NotificationBadge />
        </NavLink>
    </div>

    @* Tenant-kiezer — alleen voor Beheerder; bepaalt Session.TenantId voor alle onderstaande
       tenant-gescopede pagina's (die lezen zonder uitzondering Session.TenantId). *@
    @if (IsBeheerder())
    {
        <div class="app-nav-section">
            <div class="app-nav-heading-dark">Bekijken als tenant</div>
            @if (isLoadingTenants)
            {
                <div class="app-nav-link-icon px-3 text-muted">Laden...</div>
            }
            else
            {
                <select class="form-select form-select-sm mx-2" style="width:calc(100% - 1rem)"
                        @bind="selectedViewingTenantId" @bind:after="OnViewingTenantChangedAsync">
                    <option value="@Guid.Empty">-- Geen tenant gekozen --</option>
                    @foreach (var tenant in allTenants)
                    {
                        <option value="@tenant.Id">@tenant.Name</option>
                    }
                </select>
            }
        </div>
    }

    @* GoDutch — zichtbaar voor Beheerder en GoDutch *@
    @if (IsModuleVisible("GoDutch"))
    {
        <div class="app-nav-section">
            <div class="app-nav-heading-dark">GoDutch</div>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="godutch/stappenplan" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">✅</span>
                <span>Stappenplan</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="bankaccounts" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🏦</span>
                <span>Bankaccounts</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="snelstart/connection" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🔗</span>
                <span>SnelStart koppeling</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="godutch/sync" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🔁</span>
                <span>Sync &amp; instellingen</span>
            </NavLink>

        </div>
    }

    @* MyPos — zichtbaar voor Beheerder en MyPos *@
    @if (IsModuleVisible("MyPos"))
    {
        <div class="app-nav-section">
            <div class="app-nav-heading-dark">MyPos</div>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/stappenplan" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">✅</span>
                <span>Stappenplan</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="snelstart/connection" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🔑</span>
                <span>SnelStart koppeling</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/verbinding" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🔌</span>
                <span>MyPos-verbinding</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/snelstart-verbinding" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🔗</span>
                <span>SnelStart-verbinding</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/administrations" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🏢</span>
                <span>MyPos administratie</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/mappings" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🗂️</span>
                <span>Mappings</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/import" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">📥</span>
                <span>Import</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/auto-sync" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">⚙️</span>
                <span>Auto-sync</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/type-status" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">📊</span>
                <span>Transactie types</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/overzichten" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🧮</span>
                <span>MyPos overzichten</span>
            </NavLink>
        </div>
    }

    @* Mijn account — voor GoDutch en MyPos (niet Beheerder) *@
    @if (!IsBeheerder() && Session.IsLoggedIn)
    {
        var accountNavClass = Session.RequirePasswordChange
            ? "app-nav-link app-nav-link-urgent"
            : "app-nav-link";

        <div class="app-nav-section">
            <div class="app-nav-heading-dark">Account</div>

            <NavLink class="@accountNavClass" @onclick="ScrollToContent" href="mijn-account" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">👤</span>
                <span>Mijn account</span>
                @if (Session.RequirePasswordChange)
                {
                    <span class="app-nav-link-badge">!</span>
                }
            </NavLink>
        </div>
    }

    @* Beheer — alleen voor Beheerder *@
    @if (IsBeheerder())
    {
        <div class="app-nav-section">
            <div class="app-nav-heading-dark">Beheer</div>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="beheerder/tenants" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">📋</span>
                <span>Tenants overzicht</span>
            </NavLink>
            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="tenants/onboard" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🏢</span>
                <span>Tenant onboarden</span>
            </NavLink>
            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="beheerder/snelstart-api" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🔑</span>
                <span>SnelStart API-sleutel</span>
            </NavLink>
        </div>
    }

    <div class="app-nav-footer">
        <div class="app-nav-user-info">
            @if (!string.IsNullOrEmpty(Session.TenantName))
            {
                <div class="app-nav-tenant">@Session.TenantName</div>
            }
            <div class="app-nav-username">@Session.Username</div>
        </div>
        <button class="app-nav-logout-btn" @onclick="HandleLogout">
            <span>⬅</span> Uitloggen
        </button>
    </div>
</nav>

@code {
    private IReadOnlyList<TenantViewModel> allTenants = [];
    private bool isLoadingTenants;
    private Guid selectedViewingTenantId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += StateHasChanged;
        selectedViewingTenantId = Session.TenantId ?? Guid.Empty;

        if (IsBeheerder())
        {
            isLoadingTenants = true;
            try
            {
                allTenants = (await BackendApiClient.GetAllTenantsAsync())
                    .OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            catch { /* niet-kritiek: tenant-kiezer blijft dan leeg */ }
            finally { isLoadingTenants = false; }
        }
    }

    private Task OnViewingTenantChangedAsync()
    {
        var tenant = allTenants.FirstOrDefault(t => t.Id == selectedViewingTenantId);
        Session.SetBeheerderViewingTenant(selectedViewingTenantId, tenant?.Name ?? string.Empty);

        // Terug naar Start: een al geopende tenant-pagina heeft zijn data maar één keer
        // (in OnInitializedAsync) opgehaald met de vórige tenant, dus die ververst niet vanzelf.
        Navigation.NavigateTo("/");
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }

    private bool IsModuleVisible(string module) =>
        IsBeheerder() ||
        string.Equals(Session.Module, module, StringComparison.OrdinalIgnoreCase);

    private bool IsBeheerder() =>
        string.Equals(Session.Module, "Beheerder", StringComparison.OrdinalIgnoreCase);

    private string AppTitle => Session.Module switch
    {
        "MyPos"   => "MyPos SnelStart",
        "GoDutch" => "GoDutch SnelStart",
        _         => "Padans Portal"
    };

    private async Task ScrollToContent()
    {
        try { await JSRuntime.InvokeVoidAsync("requestScrollToContent"); } catch { }
    }

    private async Task HandleLogout()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "session_username");
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "session_module");
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "session_tenantname");
        }
        catch { }
        Session.Logout();
    }
}
